# Copy this file to .env.local for local development.
# On Vercel, add these same variables under Project Settings -> Environment Variables.

# Get this free at https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_token_here

# These two are added AUTOMATICALLY when you create a Vercel KV database
# and connect it to this project. You do not need to fill them in by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
